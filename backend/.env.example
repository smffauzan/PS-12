# ====================================================================
# VERITAS AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Fill in your deployment & Supabase / PostgreSQL credentials below.
# ====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend CORS Origin (e.g. your deployed Vercel domain, comma-separated for multiple)
FRONTEND_ORIGIN=https://YOUR-FRONTEND-URL.vercel.app

# PostgreSQL / Supabase Database Connection
# Option A: Direct PostgreSQL URI connection string (Recommended for SQLAlchemy)
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres

# Option B: Supabase REST API & Storage Client
SUPABASE_URL=https://[YOUR-SUPABASE-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Media Storage Configuration
# Set to 'true' only if media should be uploaded to Supabase Storage bucket 'forensic-media'
STORE_MEDIA=false
SUPABASE_STORAGE_BUCKET=forensic-media

# File Intake Security Controls
MAX_UPLOAD_SIZE_MB=500
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,audio/mp4
